# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#
# Get these from https://alpaca.markets -> switch to PAPER TRADING -> API Keys.
# The secret is shown once; regenerate if you lose it.
#
# Free tier is sufficient. No paid data subscription is required.

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Paper endpoints. Do not point these at live trading -- this project has no
# live execution path, and the risk engine assumes simulated fills.
#
# Alpaca's dashboard and docs show the endpoint WITH the version suffix, e.g.
# https://paper-api.alpaca.markets/v2 -- pasting that here is fine. The trailing
# /v2 is stripped on load (config.normalize_base_url) because every request
# builder appends its own /v2 path; left in place it would produce /v2/v2/orders.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Feed for historical bars. iex is one exchange. sip is the full market: on the
# free plan Alpaca limits historical data only by a 15-minute delay, and real-time
# data is IEX only. Set ALPACA_DATA_FEED=sip for full-market daily bars.
ALPACA_DATA_FEED=iex
